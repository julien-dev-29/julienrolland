---
type Props = {
  level: number;
  content: string;
};

const { level, content } = Astro.props;
---

{level == 1 && <h1 class="text-6xl">{content}</h1>}
{level == 2 && <h2 class="text-5xl">{content}</h2>}
{level == 3 && <h3 class="text-4xl">{content}</h3>}
{level == 4 && <h4 class="text-3xl">{content}</h4>}
{level == 5 && <h5 class="text-2xl">{content}</h5>}
