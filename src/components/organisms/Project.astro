---
interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  githubUrl?: string;
  liveUrl?: string;
}

const { title, description, tags, image, githubUrl, liveUrl } = Astro.props;
---

<div class="group bg-teal-900/30 border border-teal-800/50 rounded-xl overflow-hidden hover:border-teal-700 hover:shadow-lg hover:shadow-teal-900/20 transition-all duration-300">
  {image && (
    <div class="overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-48 md:h-56 object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
      />
    </div>
  )}
  <div class="p-4 md:p-6">
    <h2 class="text-xl md:text-2xl font-semibold mb-2 group-hover:text-teal-400 transition-colors duration-200">
      {title}
    </h2>
    <p class="text-teal-400/70 mb-4 text-sm md:text-base leading-relaxed">
      {description}
    </p>
    <div class="flex flex-wrap gap-2 mb-4">
      {
        tags.map((tag: string, index: number) => (
          <span
            class={`px-2 py-0.5 md:py-1 ${index % 2 == 0 ? "bg-purple-500" : "bg-blue-500"} text-white rounded-full text-xs hover:opacity-90 transition-opacity`}
          >
            {tag}
          </span>
        ))
      }
    </div>
    <div class="flex gap-3">
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-teal-800/50 text-teal-300 rounded-lg hover:bg-teal-700/50 hover:text-teal-400 transition-all duration-200 text-sm font-medium"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
        )
      }
      {
        liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-linear-to-r from-teal-500 to-cyan-500 text-teal-950 rounded-lg hover:shadow-lg hover:shadow-teal-500/25 hover:scale-105 transition-all duration-200 text-sm font-medium"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Live Demo
          </a>
        )
      }
    </div>
  </div>
</div>