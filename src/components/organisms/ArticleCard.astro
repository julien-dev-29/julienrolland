---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"blog">;
}

const { article } = Astro.props;
---

<div class="card">
  <a href={"/articles/" + article.data.slug} class="card">
    <img
      src={`/images/${article.data.image}`}
      alt={article.data.title}
      class="w-full h-48 object-cover hover:opacity-75 transition duration-300 ease-in-out"
    />
    <div class="p-6">
      <h2 class="text-2xl font-semibold mb-2">
        <a href={`/articles/${article.data.slug}`}>
          {article.data.title}
        </a>
      </h2>
      <p class="text-gray-400 mb-4 text-sm">
        {article.data.pubDate.toLocaleDateString()}
      </p>
      <div class="flex flex-wrap gap-2">
        {
          article.data.tags.map((tag: string, index: number) => (
            <span
              class={`px-2 py-1 ${index % 2 == 0 ? "bg-purple-500" : "bg-blue-500"} text-white rounded-full text-xs hover:opacity-90`}
            >
              <a href={"/articles/tag/" + tag}>{tag}</a>
            </span>
          ))
        }
      </div>
    </div>
  </a>
</div>
