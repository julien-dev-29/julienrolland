---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

const prevPage = currentPage > 1 ? `${baseUrl}${currentPage === 2 ? '' : `/${currentPage - 1}`}` : null;
const nextPage = currentPage < totalPages ? `${baseUrl}/${currentPage + 1}` : null;
---

<nav class="flex justify-center items-center gap-4 py-8" aria-label="Pagination">
  <a
    href={prevPage}
    class:list={[
      "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
      prevPage
        ? "bg-teal-900/50 text-teal-300 hover:bg-teal-800/50 hover:text-teal-200"
        : "bg-teal-900/20 text-teal-500/50 cursor-not-allowed pointer-events-none"
    ]}
    aria-disabled={!prevPage}
  >
    ← Prev
  </a>

  <span class="text-teal-400 text-sm">
    Page {currentPage} of {totalPages}
  </span>

  <a
    href={nextPage}
    class:list={[
      "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
      nextPage
        ? "bg-teal-900/50 text-teal-300 hover:bg-teal-800/50 hover:text-teal-200"
        : "bg-teal-900/20 text-teal-500/50 cursor-not-allowed pointer-events-none"
    ]}
    aria-disabled={!nextPage}
  >
    Next →
  </a>
</nav>