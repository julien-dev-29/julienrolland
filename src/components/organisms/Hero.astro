---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <div class="absolute inset-0 overflow-hidden">
    <div
      class="absolute w-96 h-96 rounded-full bg-linear-to-br from-teal-500/20 to-cyan-500/20 blur-3xl animate-float-1"
    ></div>
    <div
      class="absolute w-80 h-80 rounded-full bg-linear-to-br from-cyan-500/15 to-teal-500/15 blur-3xl animate-float-2 top-1/4 right-1/4"
    ></div>
    <div
      class="absolute w-72 h-72 rounded-full bg-linear-to-br from-teal-400/10 to-cyan-400/10 blur-3xl animate-float-3 bottom-1/4 left-1/3"
    ></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <p
      class="text-teal-400 font-medium text-lg mb-4 opacity-0 animate-fade-in"
    >
      Hello, I'm
    </p>
    <h1
      class="text-5xl md:text-7xl font-bold mb-6 opacity-0 animate-fade-in-up"
    >
      <span
        class="bg-linear-to-r from-teal-400 via-cyan-400 to-teal-400 bg-clip-text text-transparent"
      >
        Julien Rolland
      </span>
    </h1>
    <p
      class="text-xl md:text-2xl text-teal-300/80 mb-8 max-w-2xl mx-auto opacity-0 animate-fade-in-up"
      style="animation-delay: 200ms"
    >
      Full-stack Developer crafting modern web experiences with passion and
      precision
    </p>
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0 animate-fade-in-up"
      style="animation-delay: 400ms"
    >
      <a
        href="/projects"
        class="px-8 py-3 bg-linear-to-r from-teal-500 to-cyan-500 text-teal-950 font-semibold rounded-full hover:shadow-lg hover:shadow-teal-500/25 hover:scale-105 transition-all duration-300"
      >
        View Projects
      </a>
      <a
        href="/contact"
        class="px-8 py-3 border-2 border-teal-500/50 text-teal-300 font-semibold rounded-full hover:border-teal-400 hover:text-teal-400 hover:bg-teal-500/10 transition-all duration-300"
      >
        Contact Me
      </a>
    </div>
    <div
      class="flex gap-4 justify-center mt-10 opacity-0 animate-fade-in"
      style="animation-delay: 600ms"
    >
      {
        socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="p-3 rounded-full bg-teal-900/30 text-teal-400 hover:bg-teal-800/50 hover:text-teal-300 hover:scale-110 transition-all duration-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d={social.icon} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes float-1 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -30px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.95);
    }
  }

  @keyframes float-2 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(-40px, 20px) scale(1.05);
    }
    66% {
      transform: translate(30px, -20px) scale(0.9);
    }
  }

  @keyframes float-3 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(20px, 30px) scale(1.1);
    }
    66% {
      transform: translate(-30px, -10px) scale(0.95);
    }
  }

  .animate-float-1 {
    animation: float-1 20s ease-in-out infinite;
  }

  .animate-float-2 {
    animation: float-2 25s ease-in-out infinite;
    animation-delay: -5s;
  }

  .animate-float-3 {
    animation: float-3 22s ease-in-out infinite;
    animation-delay: -10s;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
    animation-delay: 100ms;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>